@baseUrl = http://localhost:3000

# RECADOS 

### Lista todos os recados 
GET {{baseUrl}}/recados/ 
?limit=10 
&offset=0 

### Lista apenas um recado 
GET {{baseUrl}}/recados/12/ 

### Cria um recado 
POST {{baseUrl}}/recados/ 
Content-Type: application/json

{
  "texto": "4 NOVO Recado", 
  "deId": 1, 
  "paraId": 9
} 

### Atualiza um recado 
PATCH {{baseUrl}}/recados/4/ 
Content-Type: application/json

{
  "texto": "ebaaa",
  "lido": true
} 
### Apaga um recado 
DELETE {{baseUrl}}/recados/5/

